import React, { forwardRef } from "react";
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { Play, Clock, Eye, MoreHorizontal } from "lucide-react";
import { cn } from "@/lib/utils";

export interface VideoCardProps {
  /**
   * Video object containing metadata
   */
  video: {
    id: string;
    title: string;
    description: string;
    thumbnail: string;
    duration: number;
    views: number;
    uploadDate: string;
    status?: "processing" | "completed" | "failed";
    transcriptAvailable?: boolean;
  };
  /**
   * Additional CSS classes to apply to the component
   */
  className?: string;
  /**
   * Card variant
   */
  variant?: "default" | "featured" | "compact" | "list";
  /**
   * Click handler for the card
   */
  onClick?: () => void;
  /**
   * Menu actions
   */
  actions?: Array<{
    label: string;
    onClick: () => void;
    variant?: "default" | "destructive";
  }>;
  /**
   * Whether to show transcript button
   */
  showTranscriptButton?: boolean;
  /**
   * Whether the card is interactive
   */
  interactive?: boolean;
}

const VideoCard = forwardRef<HTMLDivElement, VideoCardProps>(
  ({
    video,
    className,
    variant = "default",
    onClick,
    actions,
    showTranscriptButton = true,
    interactive = true,
    ...props
  }, ref) => {
    const formatDuration = (seconds: number) => {
      const minutes = Math.floor(seconds / 60);
      const remainingSeconds = seconds % 60;
      return `${minutes}:${remainingSeconds.toString().padStart(2, "0")}`;
    };

    const formatViews = (views: number) => {
      if (views >= 1000000) {
        return `${(views / 1000000).toFixed(1)}M`;
      } else if (views >= 1000) {
        return `${(views / 1000).toFixed(1)}K`;
      }
      return views.toString();
    };

    const getStatusConfig = (status?: string) => {
      const configs = {
        processing: { label: "Processing", variant: "secondary" as const },
        completed: { label: "Completed", variant: "default" as const },
        failed: { label: "Failed", variant: "destructive" as const },
      };
      return status ? configs[status] : null;
    };

    const statusConfig = getStatusConfig(video.status);

    const cardClasses = cn(
      // Base styles
      "group transition-all duration-200",
      "focus-ring rounded-lg",

      // Variant styles
      variant === "featured" && "ring-2 ring-primary ring-offset-2 shadow-lg hover:shadow-xl",
      variant === "compact" && "shadow-sm hover:shadow-md",
      variant === "list" && "shadow-sm hover:shadow-md max-w-2xl",
      variant === "default" && "shadow-sm hover:shadow-md",

      // Interactive styles
      interactive && "cursor-pointer hover:-translate-y-1",

      className
    );

    const CardComponent = interactive && onClick ? "div" : Card;

    return (
      <CardComponent
        ref={ref}
        className={cardClasses}
        onClick={interactive && onClick ? onClick : undefined}
        {...props}
      >
        {variant === "list" ? (
          // List layout
          <div className="flex gap-4 p-4">
            <div className="relative flex-shrink-0">
              <div className="aspect-video w-48 bg-muted rounded-md overflow-hidden">
                <img
                  src={video.thumbnail}
                  alt={video.title}
                  className="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>

              <div className="absolute bottom-2 right-2 bg-black/75 text-white text-xs px-2 py-1 rounded">
                {formatDuration(video.duration)}
              </div>

              {interactive && (
                <div className="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                  <div className="bg-primary/90 text-primary-foreground rounded-full p-2">
                    <Play className="w-4 h-4" />
                  </div>
                </div>
              )}
            </div>

            <div className="flex-1 min-w-0 space-y-2">
              <div className="space-y-1">
                <h3 className="font-semibold line-clamp-2 text-base sm:text-lg">
                  {video.title}
                </h3>
                <p className="text-sm text-muted-foreground line-clamp-2">
                  {video.description}
                </p>
              </div>

              <div className="flex items-center justify-between">
                <div className="flex items-center gap-4 text-sm text-muted-foreground">
                  <span className="flex items-center gap-1">
                    <Eye className="w-3 h-3" />
                    {formatViews(video.views)}
                  </span>
                  <span className="flex items-center gap-1">
                    <Clock className="w-3 h-3" />
                    {formatDuration(video.duration)}
                  </span>
                  <span>{video.uploadDate}</span>
                </div>

                {statusConfig && (
                  <Badge variant={statusConfig.variant} className="text-xs">
                    {statusConfig.label}
                  </Badge>
                )}
              </div>

              <div className="flex items-center justify-between pt-2">
                <div className="flex gap-2">
                  {showTranscriptButton && video.transcriptAvailable && (
                    <Button variant="outline" size="sm">
                      Transcript
                    </Button>
                  )}
                </div>

                {actions && actions.length > 0 && (
                  <Button variant="ghost" size="sm">
                    <MoreHorizontal className="w-4 h-4" />
                  </Button>
                )}
              </div>
            </div>
          </div>
        ) : (
          // Card layout (default, featured, compact)
          <>
            <CardHeader className={cn(
              "pb-2 sm:pb-4",
              variant === "compact" && "pb-2"
            )}>
              {/* Thumbnail */}
              <div className="relative aspect-video bg-muted rounded-md overflow-hidden">
                <img
                  src={video.thumbnail}
                  alt={video.title}
                  className="w-full h-full object-cover"
                  loading="lazy"
                />

                <div className="absolute bottom-2 right-2 bg-black/75 text-white text-xs px-2 py-1 rounded">
                  {formatDuration(video.duration)}
                </div>

                {interactive && (
                  <div className="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                    <div className="bg-primary/90 text-primary-foreground rounded-full p-2 sm:p-3">
                      <Play className="w-4 h-4 sm:w-6 sm:h-6" />
                    </div>
                  </div>
                )}

                {statusConfig && (
                  <div className="absolute top-2 left-2">
                    <Badge variant={statusConfig.variant} className="text-xs">
                      {statusConfig.label}
                    </Badge>
                  </div>
                )}
              </div>

              {/* Title and Description */}
              <div className="pt-2 sm:pt-4 space-y-1 sm:space-y-2">
                <CardTitle className={cn(
                  "line-clamp-2",
                  variant === "compact" ? "text-sm sm:text-base" : "text-base sm:text-lg"
                )}>
                  {video.title}
                </CardTitle>

                {variant !== "compact" && (
                  <CardDescription className="line-clamp-2 text-sm">
                    {video.description}
                  </CardDescription>
                )}
              </div>
            </CardHeader>

            <CardContent className={cn(
              "pt-0",
              variant === "compact" && "pt-0"
            )}>
              {/* Metadata */}
              <div className="flex items-center justify-between text-xs sm:text-sm text-muted-foreground">
                <div className="flex items-center gap-3 sm:gap-4">
                  <span className="flex items-center gap-1">
                    <Eye className="w-3 h-3" />
                    {formatViews(video.views)}
                  </span>
                  <span className="flex items-center gap-1">
                    <Clock className="w-3 h-3" />
                    {formatDuration(video.duration)}
                  </span>
                </div>

                <span>{video.uploadDate}</span>
              </div>
            </CardContent>

            {variant !== "compact" && (
              <CardFooter className="pt-2 sm:pt-4">
                <div className="flex items-center justify-between w-full">
                  <div className="flex gap-2">
                    {showTranscriptButton && video.transcriptAvailable && (
                      <Button variant="outline" size="sm" className="text-xs sm:text-sm">
                        Transcript
                      </Button>
                    )}
                  </div>

                  {actions && actions.length > 0 && (
                    <Button variant="ghost" size="sm">
                      <MoreHorizontal className="w-4 h-4" />
                    </Button>
                  )}
                </div>
              </CardFooter>
            )}
          </>
        )}
      </CardComponent>
    );
  }
);

VideoCard.displayName = "VideoCard";

export default VideoCard;