# =============================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# =============================================================================
# Generated on: $(date)
# Environment: Development
# Project: iReadYouTube
# =============================================================================

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
NODE_ENV=development
RESTART_POLICY=unless-stopped

# =============================================================================
# DOCKER PORT CONFIGURATION
# =============================================================================
CLIENT_HOST_PORT=5173
CONVEX_API_HOST_PORT=3210
CONVEX_DASHBOARD_HOST_PORT=6791
REDIS_HOST_PORT=6379
NGINX_HOST_PORT=80
NGINX_SSL_HOST_PORT=443

# =============================================================================
# CONVEX SELF-HOSTED CONFIGURATION
# =============================================================================
CONVEX_SELF_HOSTED_URL=http://0.0.0.0:3210
CONVEX_ADMIN_KEY=GENERATE_WITH_MAKE_ADMIN_KEY
CONVEX_SITE_URL=http://localhost:5173

# =============================================================================
# EXTERNAL SERVICE API KEYS - DEVELOPMENT
# =============================================================================
# AssemblyAI API Configuration
ASSEMBLYAI_API_KEY=your_development_assemblyai_api_key
ASSEMBLYAI_WEBHOOK_SECRET=your_development_webhook_secret
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com

# YouTube API Configuration
YOUTUBE_API_KEY=your_development_youtube_api_key

# Email Service Configuration (Resend)
RESEND_API_KEY=your_development_resend_api_key
RESEND_FROM_EMAIL=noreply@localhost
RESEND_FROM_NAME=iReadYouTube (Dev)

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
JWT_SECRET=dev_jwt_secret_change_in_production
SESSION_SECRET=dev_session_secret_change_in_production
ENCRYPTION_KEY=dev_encryption_key_change_in_production

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Redis Configuration
REDIS_PASSWORD=dev_redis_password

# Convex Data Configuration
CONVEX_DATA_PATH=./data/convex
CONVEX_UPLOADS_PATH=/app/convex/uploads
CONVEX_UPLOADS_DATA_PATH=./data/uploads

# =============================================================================
# NGINX CONFIGURATION (Optional for Development)
# =============================================================================
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024
NGINX_DOMAIN=localhost
# NGINX_SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
# NGINX_SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# =============================================================================
# DOCKER NETWORK CONFIGURATION
# =============================================================================
DOCKER_NETWORK_NAME=ireadyoutube-network
DOCKER_NETWORK_SUBNET=172.20.0.0/16
DOCKER_NETWORK_GATEWAY=172.20.0.1
DOCKER_NETWORK_BRIDGE=ireadyoutube-br

# =============================================================================
# VOLUME CONFIGURATION
# =============================================================================
# Data persistence paths
REDIS_DATA_PATH=./data/redis
CONVEX_DATA_PATH=./data/convex
CONVEX_UPLOADS_DATA_PATH=./data/uploads

# =============================================================================
# MONITORING CONFIGURATION (Optional for Development)
# =============================================================================
# Prometheus Configuration
PROMETHEUS_HOST_PORT=9090
PROMETHEUS_RETENTION=24h

# Grafana Configuration
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# =============================================================================
# CLIENT CONFIGURATION
# =============================================================================
CLIENT_DOMAIN=localhost
CLIENT_VOLUME_SOURCE=../client
CLIENT_MOUNT_PATH=/app
CLIENT_WORKING_DIR=/app

# Development file watching settings
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=1000

# =============================================================================
# CONVEX CONFIGURATION
# =============================================================================
CONVEX_CONTAINER_NAME=ireadyoutube-convex-backend
CONVEX_API_CONTAINER_PORT=3210
CONVEX_DASHBOARD_CONTAINER_PORT=6791
CONVEX_WORKING_DIR=/app

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=30s

# Service-specific health check start periods
CONVEX_HEALTH_CHECK_START_PERIOD=60s
CLIENT_HEALTH_CHECK_START_PERIOD=30s
NGINX_HEALTH_CHECK_START_PERIOD=30s

# =============================================================================
# DOCKER IMAGE CONFIGURATION
# =============================================================================
NODE_IMAGE=node:20-alpine
REDIS_IMAGE=redis:7-alpine
NGINX_IMAGE=nginx:alpine
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana:latest

# =============================================================================
# CONTAINER NAMES
# =============================================================================
REDIS_CONTAINER_NAME=ireadyoutube-redis
CLIENT_CONTAINER_NAME=ireadyoutube-client
NGINX_CONTAINER_NAME=ireadyoutube-nginx
PROMETHEUS_CONTAINER_NAME=ireadyoutube-prometheus
GRAFANA_CONTAINER_NAME=ireadyoutube-grafana

# =============================================================================
# RESTART POLICIES
# =============================================================================
REDIS_RESTART_POLICY=unless-stopped
CONVEX_RESTART_POLICY=unless-stopped
CLIENT_RESTART_POLICY=unless-stopped
NGINX_RESTART_POLICY=unless-stopped
PROMETHEUS_RESTART_POLICY=unless-stopped
GRAFANA_RESTART_POLICY=unless-stopped

# =============================================================================
# RESOURCE LIMITS (Relaxed for Development)
# =============================================================================
# Memory limits (in MB)
REDIS_MEMORY_LIMIT=512
CONVEX_MEMORY_LIMIT=1024
CLIENT_MEMORY_LIMIT=512
NGINX_MEMORY_LIMIT=256

# CPU limits (in cores)
REDIS_CPU_LIMIT=0.5
CONVEX_CPU_LIMIT=1.0
CLIENT_CPU_LIMIT=0.5
NGINX_CPU_LIMIT=0.25

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log levels (more verbose for development)
LOG_LEVEL=debug
CONVEX_LOG_LEVEL=debug
NGINX_LOG_LEVEL=info

# Log rotation settings (shorter for development)
LOG_MAX_SIZE=50M
LOG_MAX_FILES=5

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Backup settings (manual for development)
BACKUP_ENABLED=false
BACKUP_SCHEDULE=manual
BACKUP_RETENTION_DAYS=7
BACKUP_COMPRESSION=true
BACKUP_ENCRYPTION=false

# Backup storage
BACKUP_STORAGE_PATH=./backups
REMOTE_BACKUP_ENABLED=false
REMOTE_BACKUP_S3_BUCKET=

# =============================================================================
# PERFORMANCE OPTIMIZATION
# =============================================================================
# Connection pooling (relaxed for development)
REDIS_MAX_CONNECTIONS=50
CONVEX_MAX_CONNECTIONS=25

# Caching settings (shorter TTL for development)
REDIS_TTL=300
CACHE_MAX_SIZE=500

# =============================================================================
# SECURITY HEADERS (Relaxed for Development)
# =============================================================================
# Content Security Policy (more permissive for development)
CSP_DEFAULT_SRC="'self' 'unsafe-inline'"
CSP_SCRIPT_SRC="'self' 'unsafe-inline' 'unsafe-eval'"
CSP_STYLE_SRC="'self' 'unsafe-inline'"
CSP_IMG_SRC="'self' data: https: http:"
CSP_CONNECT_SRC="'self' https://api.assemblyai.com ws: wss:"

# Additional security headers (relaxed for development)
X_FRAME_OPTIONS=SAMEORIGIN
X_CONTENT_TYPE_OPTIONS=nosniff
X_XSS_PROTECTION="1; mode=block"
# STRICT_TRANSPORT_SECURITY=""  # Disabled for HTTP development

# =============================================================================
# RATE LIMITING (Relaxed for Development)
# =============================================================================
# API rate limiting
API_RATE_LIMIT_REQUESTS=1000
API_RATE_LIMIT_WINDOW=3600

# Authentication rate limiting
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW=900

# =============================================================================
# MONITORING AND ALERTING
# =============================================================================
# Health check endpoints
HEALTH_CHECK_ENDPOINTS=/health,/api/health,/convex/health

# Alert configuration (disabled for development)
ALERT_EMAIL=
ALERT_WEBHOOK_URL=

# Metrics collection (enabled for development)
METRICS_ENABLED=true
METRICS_PORT=9090

# =============================================================================
# COMPLIANCE AND AUDITING
# =============================================================================
# Audit logging (minimal for development)
AUDIT_ENABLED=false
AUDIT_LOG_PATH=./logs/audit.log

# Data retention (shorter for development)
USER_DATA_RETENTION_DAYS=30
LOG_RETENTION_DAYS=7

# =============================================================================
# DEVELOPMENT SPECIFIC SETTINGS
# =============================================================================
# Enable development features
DEBUG=true
VERBOSE_LOGGING=true
HOT_RELOAD=true
SOURCE_MAPS=true

# Disable some production features for easier development
DISABLE_SSL_VERIFICATION=true
DISABLE_RATE_LIMITING=false
DISABLE_CORS=false

# Development database settings
CONVEX_DEV_MODE=true
REDIS_DEV_MODE=true

# File watching for hot reload
FILE_WATCHING_ENABLED=true
POLLING_INTERVAL=1000

# Development server settings
VITE_DEV_SERVER_HOST=0.0.0.0
VITE_DEV_SERVER_PORT=5173

# Bundle optimization (disabled for faster builds)
VITE_BUILD_MINIFY=false
VITE_BUILD_SOURCEMAP=true

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================
# Test database settings
TEST_REDIS_DB=1
TEST_CONVEX_INSTANCE=test

# Test environment variables
TEST_ASSEMBLYAI_API_KEY=test_api_key
TEST_YOUTUBE_API_KEY=test_youtube_key

# Test execution settings
TEST_TIMEOUT=30000
TEST_PARALLEL=true

# =============================================================================
# DEBUGGING TOOLS
# =============================================================================
# Enable debugging endpoints
DEBUG_ENDPOINTS_ENABLED=true
DEBUG_UI_ENABLED=true

# Profiling settings
ENABLE_PROFILING=true
PROFILE_OUTPUT_PATH=./profiles

# Memory debugging
MEMORY_DEBUGGING=true
HEAPDUMP_ENABLED=true

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================
# These settings override production defaults for development convenience

# Allow insecure connections (for local development)
NODE_TLS_REJECT_UNAUTHORIZED=0

# Skip SSL certificate verification
SSL_VERIFICATION_DISABLED=true

# Enable all CORS origins
CORS_ORIGIN="*"

# Disable authentication bypass (for testing)
BYPASS_AUTH_FOR_LOCALHOST=true

# Enable development console
DEV_CONSOLE_ENABLED=true

# Mock external services (optional)
MOCK_EXTERNAL_APIS=false
MOCK_ASYNCHRONOUS_PROCESSING=true