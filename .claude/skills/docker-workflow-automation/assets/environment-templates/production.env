# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Generated on: $(date)
# Environment: Production
# Project: iReadYouTube
# =============================================================================

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
NODE_ENV=production
RESTART_POLICY=always

# =============================================================================
# DOCKER PORT CONFIGURATION
# =============================================================================
CLIENT_HOST_PORT=5173
CONVEX_API_HOST_PORT=3210
CONVEX_DASHBOARD_HOST_PORT=6791
REDIS_HOST_PORT=6379
NGINX_HOST_PORT=80
NGINX_SSL_HOST_PORT=443

# =============================================================================
# CONVEX SELF-HOSTED CONFIGURATION
# =============================================================================
CONVEX_SELF_HOSTED_URL=http://0.0.0.0:3210
CONVEX_ADMIN_KEY=GENERATE_WITH_MAKE_ADMIN_KEY
CONVEX_SITE_URL=https://your-domain.com

# =============================================================================
# EXTERNAL SERVICE API KEYS - PRODUCTION
# =============================================================================
# AssemblyAI API Configuration
ASSEMBLYAI_API_KEY=your_production_assemblyai_api_key
ASSEMBLYAI_WEBHOOK_SECRET=your_production_webhook_secret
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com

# YouTube API Configuration
YOUTUBE_API_KEY=your_production_youtube_api_key

# Email Service Configuration (Resend)
RESEND_API_KEY=your_production_resend_api_key
RESEND_FROM_EMAIL=noreply@your-domain.com
RESEND_FROM_NAME=iReadYouTube

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
JWT_SECRET=your_strong_jwt_secret_minimum_32_characters
SESSION_SECRET=your_strong_session_secret_minimum_32_characters
ENCRYPTION_KEY=your_strong_encryption_key_minimum_32_characters

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Redis Configuration
REDIS_PASSWORD=your_strong_redis_password

# Convex Data Configuration
CONVEX_DATA_PATH=/opt/ireadyoutube/data/convex
CONVEX_UPLOADS_PATH=/app/convex/uploads
CONVEX_UPLOADS_DATA_PATH=/opt/ireadyoutube/data/uploads

# =============================================================================
# NGINX CONFIGURATION
# =============================================================================
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024
NGINX_DOMAIN=your-domain.com
NGINX_SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
NGINX_SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# =============================================================================
# DOCKER NETWORK CONFIGURATION
# =============================================================================
DOCKER_NETWORK_NAME=ireadyoutube-network
DOCKER_NETWORK_SUBNET=172.20.0.0/16
DOCKER_NETWORK_GATEWAY=172.20.0.1
DOCKER_NETWORK_BRIDGE=ireadyoutube-br

# =============================================================================
# VOLUME CONFIGURATION
# =============================================================================
# Data persistence paths
REDIS_DATA_PATH=/opt/ireadyoutube/data/redis
CONVEX_DATA_PATH=/opt/ireadyoutube/data/convex
CONVEX_UPLOADS_DATA_PATH=/opt/ireadyoutube/data/uploads

# =============================================================================
# MONITORING CONFIGURATION (Optional)
# =============================================================================
# Prometheus Configuration
PROMETHEUS_HOST_PORT=9090
PROMETHEUS_RETENTION=200h

# Grafana Configuration
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password

# =============================================================================
# CLIENT CONFIGURATION
# =============================================================================
CLIENT_DOMAIN=your-domain.com
CLIENT_VOLUME_SOURCE=
CLIENT_MOUNT_PATH=/app
CLIENT_WORKING_DIR=/app

# Development polling (disabled in production)
CHOKIDAR_USEPOLLING=false
CHOKIDAR_INTERVAL=1000

# =============================================================================
# CONVEX CONFIGURATION
# =============================================================================
CONVEX_CONTAINER_NAME=ireadyoutube-convex-backend
CONVEX_API_CONTAINER_PORT=3210
CONVEX_DASHBOARD_CONTAINER_PORT=6791
CONVEX_WORKING_DIR=/app

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=30s

# Service-specific health check start periods
CONVEX_HEALTH_CHECK_START_PERIOD=60s
CLIENT_HEALTH_CHECK_START_PERIOD=30s
NGINX_HEALTH_CHECK_START_PERIOD=30s

# =============================================================================
# DOCKER IMAGE CONFIGURATION
# =============================================================================
NODE_IMAGE=node:20-alpine
REDIS_IMAGE=redis:7-alpine
NGINX_IMAGE=nginx:alpine
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana:latest

# =============================================================================
# CONTAINER NAMES
# =============================================================================
REDIS_CONTAINER_NAME=ireadyoutube-redis
CLIENT_CONTAINER_NAME=ireadyoutube-client
NGINX_CONTAINER_NAME=ireadyoutube-nginx
PROMETHEUS_CONTAINER_NAME=ireadyoutube-prometheus
GRAFANA_CONTAINER_NAME=ireadyoutube-grafana

# =============================================================================
# RESTART POLICIES
# =============================================================================
REDIS_RESTART_POLICY=always
CONVEX_RESTART_POLICY=always
CLIENT_RESTART_POLICY=always
NGINX_RESTART_POLICY=always
PROMETHEUS_RESTART_POLICY=unless-stopped
GRAFANA_RESTART_POLICY=unless-stopped

# =============================================================================
# RESOURCE LIMITS
# =============================================================================
# Memory limits (in MB)
REDIS_MEMORY_LIMIT=512
CONVEX_MEMORY_LIMIT=1024
CLIENT_MEMORY_LIMIT=512
NGINX_MEMORY_LIMIT=256

# CPU limits (in cores)
REDIS_CPU_LIMIT=0.5
CONVEX_CPU_LIMIT=1.0
CLIENT_CPU_LIMIT=0.5
NGINX_CPU_LIMIT=0.25

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================
# Certificate paths (update with your actual certificate paths)
SSL_CERTIFICATE_PATH=/etc/ssl/certs/your-domain.crt
SSL_PRIVATE_KEY_PATH=/etc/ssl/private/your-domain.key
SSL_CHAIN_PATH=/etc/ssl/certs/your-domain-chain.crt

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log levels
LOG_LEVEL=info
CONVEX_LOG_LEVEL=info
NGINX_LOG_LEVEL=warn

# Log rotation settings
LOG_MAX_SIZE=100M
LOG_MAX_FILES=10

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true
BACKUP_ENCRYPTION=false

# Backup storage
BACKUP_STORAGE_PATH=/opt/ireadyoutube/backups
REMOTE_BACKUP_ENABLED=false
REMOTE_BACKUP_S3_BUCKET=ireadyoutube-backups

# =============================================================================
# PERFORMANCE OPTIMIZATION
# =============================================================================
# Connection pooling
REDIS_MAX_CONNECTIONS=100
CONVEX_MAX_CONNECTIONS=50

# Caching settings
REDIS_TTL=3600
CACHE_MAX_SIZE=1000

# =============================================================================
# SECURITY HEADERS
# =============================================================================
# Content Security Policy
CSP_DEFAULT_SRC="'self'"
CSP_SCRIPT_SRC="'self' 'unsafe-inline'"
CSP_STYLE_SRC="'self' 'unsafe-inline'"
CSP_IMG_SRC="'self' data: https:"
CSP_CONNECT_SRC="'self' https://api.assemblyai.com"

# Additional security headers
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
X_XSS_PROTECTION="1; mode=block"
STRICT_TRANSPORT_SECURITY="max-age=63072000; includeSubDomains; preload"

# =============================================================================
# RATE LIMITING
# =============================================================================
# API rate limiting
API_RATE_LIMIT_REQUESTS=100
API_RATE_LIMIT_WINDOW=3600

# Authentication rate limiting
AUTH_RATE_LIMIT_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW=900

# =============================================================================
# MONITORING AND ALERTING
# =============================================================================
# Health check endpoints
HEALTH_CHECK_ENDPOINTS=/health,/api/health,/convex/health

# Alert configuration
ALERT_EMAIL=admin@your-domain.com
ALERT_WEBHOOK_URL=https://hooks.slack.com/your-webhook-url

# Metrics collection
METRICS_ENABLED=true
METRICS_PORT=9090

# =============================================================================
# COMPLIANCE AND AUDITING
# =============================================================================
# Audit logging
AUDIT_ENABLED=true
AUDIT_LOG_PATH=/var/log/ireadyoutube/audit.log

# Data retention
USER_DATA_RETENTION_DAYS=2555  # 7 years
LOG_RETENTION_DAYS=90

# =============================================================================
# DEVELOPMENT OVERRIDES (DO NOT USE IN PRODUCTION)
# =============================================================================
# These settings should remain commented out in production
# DEBUG=true
# VERBOSE_LOGGING=true
# DISABLE_AUTH=false
# DISABLE_RATE_LIMITING=false