# WordPress Static Generation Stack - Environment Variables
# =========================================================
# Copy this file to .env and configure your values
#
# Required variables are marked with [REQUIRED]

# ============================================================
# STACK IDENTIFICATION [REQUIRED]
# ============================================================

# Unique identifier for this stack (lowercase, alphanumeric, hyphens)
APP_NAME=myblog

# Primary domain for the static site (without www)
DOMAIN=myblog.com

# ============================================================
# DATABASE [REQUIRED]
# ============================================================

# WordPress database user
WORDPRESS_DB_USER=wordpress

# WordPress database password [REQUIRED - CHANGE THIS!]
WORDPRESS_DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD_123

# WordPress database name
WORDPRESS_DB_NAME=wordpress

# ============================================================
# PHP SETTINGS (Optional - defaults shown)
# ============================================================

# Upload limits
PHP_UPLOAD_MAX_FILESIZE=256M
PHP_POST_MAX_SIZE=256M

# Memory and execution
PHP_MEMORY_LIMIT=512M
PHP_MAX_EXECUTION_TIME=300
PHP_MAX_INPUT_TIME=300
PHP_MAX_INPUT_VARS=3000

# OPcache settings
PHP_OPCACHE_MEMORY=128
PHP_OPCACHE_MAX_FILES=4000
# Set to 1 during development, 0 for production
PHP_OPCACHE_VALIDATE=0

# ============================================================
# NGINX SETTINGS (Optional)
# ============================================================

# Max upload size for nginx
NGINX_CLIENT_MAX_BODY_SIZE=256M

# ============================================================
# REDIS SETTINGS (Optional)
# ============================================================

# Maximum memory for Redis cache
REDIS_MAXMEMORY=256mb

# Eviction policy when memory limit is reached
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ============================================================
# RESOURCE LIMITS (Optional - for production tuning)
# ============================================================

# WordPress container
WORDPRESS_CPU_LIMIT=1.0
WORDPRESS_MEMORY_LIMIT=1G

# MariaDB container
DB_CPU_LIMIT=1.0
DB_MEMORY_LIMIT=1G

# Redis container
REDIS_CPU_LIMIT=0.5
REDIS_MEMORY_LIMIT=512M

# Nginx admin container
NGINX_CPU_LIMIT=0.5
NGINX_MEMORY_LIMIT=256M

# Static web container
STATIC_CPU_LIMIT=0.25
STATIC_MEMORY_LIMIT=128M

# phpMyAdmin container
PHPMYADMIN_CPU_LIMIT=0.5
PHPMYADMIN_MEMORY_LIMIT=256M
PMA_UPLOAD_LIMIT=256M

# ============================================================
# NOTES
# ============================================================
#
# Domains configured by this stack:
#   - https://${DOMAIN} - Static site (public)
#   - https://admin.${DOMAIN} - WordPress admin
#   - https://pma.${DOMAIN} - phpMyAdmin
#
# Wake/Sleep pattern:
#   - Factory services (wordpress, nginx-admin, db, redis, phpmyadmin)
#     have restart: "no" and will stop when explicitly stopped
#   - Static-web has restart: always and runs 24/7
#
# To wake factory:
#   docker compose up -d wordpress nginx-admin db redis phpmyadmin
#
# To sleep factory:
#   docker compose stop wordpress nginx-admin db redis phpmyadmin
#
# To generate static content:
#   1. Wake factory
#   2. Log into WordPress admin
#   3. Use WP2Static plugin
#   4. Sleep factory
