# Root .env is the single source of truth. Never create .env files in
# subdirectories. Consumed by `docker compose` at compose-time AND by the `api`
# runtime container.
#
# Quick start:
#   cp .env.example .env
#   # generate the three secrets below
#   for v in MASTER_ENCRYPTION_KEY JWT_SECRET SESSION_SECRET; do
#     echo "$v=$(openssl rand -hex 32)"
#   done
#   docker compose up -d --build
#
# See docs/self-hosting.md for the full walkthrough.


# ===========================================================================
# REQUIRED
# ===========================================================================

# --- Encryption -----------------------------------------------------------
# The AES-256-GCM master key that encrypts every secret at rest (storage-VPS
# SSH private key, restic repo passwords, agent API secrets). Startup fails if
# it is missing or decodes to fewer than 32 bytes. Accepted encodings, tried in
# order: hex, base64, utf8 — the first that yields >= 32 bytes wins, and only
# the first 32 bytes become the key.
#
# WARNING: losing this key makes every ciphertext in Mongo permanently
# unrecoverable. Back it up out of band, not only inside the backups this tool
# produces. Rotation runbook: server/src/shared/crypto/README.md
#
# Generate: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=replace-me-with-a-random-64-char-hex-string

# --- Auth (generate each with: openssl rand -hex 32) ----------------------
JWT_SECRET=replace-me-with-a-random-64-char-hex-string
SESSION_SECRET=replace-me-with-a-random-64-char-hex-string

# --- Datastores — hostnames resolve on the compose `dockstash` network ----
MONGODB_URI=mongodb://mongo:27017/dockstash
REDIS_URL=redis://redis:6379

# --- Public URLs ----------------------------------------------------------
# Where a browser reaches the app and the API. Behind a reverse proxy these are
# your public https:// origins. CORS is locked to CLIENT_URL exactly.
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:8080

# --- Client build-time (Vite) --------------------------------------------
# Baked into the browser bundle at image build time, so they MUST be origins a
# browser can reach — not compose-internal hostnames.
VITE_API_BASE_URL=http://localhost:8080/api
VITE_SOCKET_URL=http://localhost:8080


# ===========================================================================
# OPTIONAL — every value below has a working default
# ===========================================================================

# --- Runtime --------------------------------------------------------------
NODE_ENV=production
PORT=8080
LOG_LEVEL=info
# Host port published for the `web` container (which listens on 3000 inside).
WEB_PORT=3000
# Host port published for the `api` container (which listens on 8080 inside).
API_PORT=8080
# Host directory exposed inside Dockstash as `/var/www`. Keep the default on
# Linux; Docker Desktop users should choose a directory shared with its VM.
PROJECTS_ROOT=/var/www
# Server-side default locale when Accept-Language and the cookie are missing.
# One of: en, ar, fr, de, es, ru, zh.
DEFAULT_LOCALE=en

# --- Email (Resend) -------------------------------------------------------
# Unset = no transactional or alert email is sent; everything else still works.
RESEND_API_KEY=
RESEND_FROM=

# --- OAuth sign-in (Google / GitHub) -------------------------------------
# A provider is enabled only when BOTH its client id and secret are set;
# otherwise its button is hidden. Register these redirect URIs with the
# provider (see docs/oauth-setup.en.md):
#   ${SERVER_URL}/api/auth/google/callback
#   ${SERVER_URL}/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Alerting -------------------------------------------------------------
# Hours between heartbeat / health-alert cycles.
ALERT_HEARTBEAT_HOURS=24
# When set, `sendFailureAlert` POSTs the alert payload here in addition to the
# email channel.
ALERT_WEBHOOK_URL=

# --- Disaster recovery (self-backup) --------------------------------------
# Dedicated restic repository for the orchestrator's own Mongo. Compose mounts
# a persistent volume at this default path; set a remote restic URL for off-host
# protection and provide that backend's standard restic credentials.
SELF_BACKUP_REPO=/self-backup
# Cron cadence for the self-backup job.
SELF_BACKUP_CRON=0 3 * * *

# --- Restic execution -----------------------------------------------------
# `process` spawns the real pinned restic binary (the compose default);
# `placeholder` keeps the loud not-wired runner for tests and bare dev.
RESTIC_RUNNER=placeholder
RESTIC_BINARY=restic
RESTIC_CACHE_DIR=/tmp/restic-cache

# --- Docker access --------------------------------------------------------
# Docker Engine endpoint used for database dump execs. Compose points this at
# the least-privilege socket proxy; blank disables container execs.
DOCKER_HOST=

# --- Contact form ---------------------------------------------------------
# Blank falls back to a placeholder recipient plus a startup warning.
CONTACT_RECIPIENT=

# --- Rate limits ----------------------------------------------------------
# Auth routes: window + max requests per IP inside the window.
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
# Fleet-agent machine surface (/api/agent). Sized for one agent per IP
# (heartbeat ~30s + poll ~10s + log batches).
RATE_LIMIT_AGENT_WINDOW_MS=60000
RATE_LIMIT_AGENT_MAX=600

# --- Fleet agents ---------------------------------------------------------
# An agent counts as offline once its last heartbeat is older than this (3x beat).
AGENT_OFFLINE_AFTER_SECONDS=90
# A leased agent job fails if it is not renewed (log posts renew) in this window.
AGENT_JOB_LEASE_SECONDS=900

# --- CSRF -----------------------------------------------------------------
# Double-submit cookie + header names for cookie-authenticated surfaces.
CSRF_COOKIE_NAME=x-csrf-token
CSRF_HEADER_NAME=x-csrf-token

# --- Data rights ----------------------------------------------------------
# Account-deletion grace period in hours. The purge is queued this far in the
# future; the final warning email fires 24h before it runs. Default: 30 days.
ACCOUNT_DELETION_GRACE_HOURS=720

# --- Fleet-agent image ----------------------------------------------------
# Container image the dashboard tells a remote VPS to pull, baked into the
# browser bundle when `web` is built. Dockstash ships no prebuilt image and no
# registry account — publish your own and name it here. The repository must be
# public: the generated install snippet never runs `docker login`.
# See docs/fleet-agents.en.md § "Build and publish the agent image".
VITE_AGENT_IMAGE=

# --- Source-code offer (AGPL-3.0 §13) ------------------------------------
# Dockstash is AGPL-3.0. If you run a MODIFIED version as a network service,
# §13 requires you to offer your users the source of that modified version.
# The app links here from its footer. Set this to your fork when you deploy
# changes; leave it blank on an unmodified install and it points upstream.
# Baked into the browser bundle at build time — changing it means rebuilding
# the `web` image.
VITE_SOURCE_URL=

# --- Storage SSH ----------------------------------------------------------
# Host-key pin for the storage target (`sha256:BASE64`). Leave blank in dev;
# set it in production — the SSH transport rejects a mismatch and never
# auto-accepts an unknown host key.
STORAGE_SSH_HOST_KEY_FINGERPRINT=
