# Root .env is the single source of truth. Never create .env files in subdirectories.

# Runtime
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Database
MONGODB_URI=mongodb://localhost:27017/mern-starter

# Auth (replace with random 64-char hex strings)
JWT_SECRET=replace-me-with-a-random-64-char-hex-string
SESSION_SECRET=replace-me-with-a-random-64-char-hex-string

# URLs
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:8080

# Third-party integrations (optional — leave blank if unused)
STRIPE_SECRET_KEY=
SENDGRID_API_KEY=
MAILGUN_PRIVATE_KEY=
MAILGUN_DOMAIN=
MAILCHIMP_API_KEY=
