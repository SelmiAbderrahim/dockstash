# Root .env is the single source of truth. Never create .env files in subdirectories.
# Consumed by `docker compose` at compose-time AND by the `api` runtime container.

# Runtime
NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# Host port for the `web` container (Node SSR server — server.js, listens on 3000).
WEB_PORT=3000

# Databases / queues — service hostnames resolve on the compose `dockstash` network.
MONGODB_URI=mongodb://mongo:27017/dockstash
REDIS_URL=redis://redis:6379

# Auth (generate: openssl rand -hex 32)
JWT_SECRET=replace-me-with-a-random-64-char-hex-string
SESSION_SECRET=replace-me-with-a-random-64-char-hex-string

# Public URLs
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:8080

# i18n — optional. Server-side default locale when Accept-Language and cookie/override are missing.
# Must be one of: en, ar, fr, de, es, ru, zh. Defaults to `en`.
DEFAULT_LOCALE=en

# Client build-time (Vite) — MUST be reachable from a browser, so use public URLs.
VITE_API_BASE_URL=http://localhost:8080/api
VITE_SOCKET_URL=http://localhost:8080
# Public origin of the site — used to build absolute canonical / Open Graph /
# hreflang / sitemap URLs for the server-rendered marketing pages, and by the
# web server for the www→apex canonical-host redirect. No trailing slash.
VITE_SITE_URL=http://localhost:3000
# Internal origin of the api service, used by the web SSR server (server.js) to
# reverse-proxy /robots.txt, /sitemap*.xml and /llms.txt. In Docker: http://api:8080.
API_INTERNAL_URL=http://localhost:8080

# ===========================================================================
# Encryption — REQUIRED. Fails startup if missing or decodes to < 32 bytes.
# ===========================================================================
# The AES-256-GCM master key that encrypts secrets at rest (Polar tokens,
# storage-VPS SSH private key, restic repo password, etc.). Accepted encodings
# tried in order: hex, base64, utf8. First encoding that yields >= 32 bytes wins;
# only the first 32 bytes are used as the AES-256 key.
#
# WARNING: Losing this key = every ciphertext in Mongo becomes unrecoverable.
# Back it up out-of-band. Rotation runbook: server/src/shared/crypto/README.md
#
# Generate: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=replace-me-with-a-random-64-char-hex-string

# ===========================================================================
# Payments (Polar) — OPTIONAL. Free / self-host tier boots without these.
# ===========================================================================
# PAYMENT_PROVIDER: `none` | `polar` | `stripe`.
#   - `none` disables billing entirely (checkout/portal/change-plan return 500)
#     — even if POLAR_ACCESS_TOKEN is set. Activation requires BOTH the flag
#     and the matching credential.
#   - `polar` + POLAR_ACCESS_TOKEN enables the Polar integration and the
#     billing background jobs (reconcile every 15 min, grace-expiry hourly).
#   - `stripe` selects the inactive legacy adapter; must be implemented by hand.
# The webhook route (/api/billing/webhook) is always registered — it verifies
# Standard Webhooks HMAC-SHA256 signatures BEFORE parsing and depends on
# POLAR_WEBHOOK_SECRET below. The Polar access token is wrapped in an at-rest
# AES-256-GCM envelope (MASTER_ENCRYPTION_KEY) and decrypted only at call time.
PAYMENT_PROVIDER=none
# Organization access token. Sandbox tokens come from https://sandbox.polar.sh,
# production tokens from https://polar.sh — must match POLAR_SERVER below.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# sandbox | production (empty = production API base). Product IDs, tokens and
# webhook secrets are environment-specific — never mix sandbox and production.
POLAR_SERVER=
# Product IDs from the Polar dashboard. They map tier+interval → product for
# checkout and reverse-map product → plan on webhooks (getPlanForProductId);
# an unknown/missing ID resolves to the free tier. Prices themselves live in
# server/src/modules/billing/plans.ts (Pro $9/mo, Business $29/mo).
# Pro monthly:
POLAR_PRO_PRODUCT_ID=
# Business monthly:
POLAR_BUSINESS_PRODUCT_ID=
# Yearly variants (10x monthly = "two months free"). Optional; if unset the
# yearly toggle in the pricing grid will not be selectable for that tier.
POLAR_PRO_YEARLY_PRODUCT_ID=
POLAR_BUSINESS_YEARLY_PRODUCT_ID=

# ===========================================================================
# Email (Resend) — OPTIONAL. Free / self-host tier boots without these.
# ===========================================================================
RESEND_API_KEY=
RESEND_FROM=

# ===========================================================================
# Superadmin bootstrap — OPTIONAL. Free / self-host tier boots without these.
# ===========================================================================
# When both are set, the Docker entrypoint seeder creates the Superadmin
# account ONCE (email lowercased, password >= 12 chars). It NEVER overwrites
# an existing user: changing these values later does NOT rotate the password
# or role. Login from a new device/IP triggers an email OTP to this address.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ===========================================================================
# Alerting — OPTIONAL with a sane default.
# ===========================================================================
# Interval (hours) between heartbeat / health-alert cycles. Default: 24.
ALERT_HEARTBEAT_HOURS=24

# Optional. When set, `sendFailureAlert` POSTs the alert payload to this URL
# in addition to the Resend email (per IDEA.md §7).
ALERT_WEBHOOK_URL=

# ===========================================================================
# Disaster recovery (self-backup) — OPTIONAL with sane defaults.
# ===========================================================================
# Reserved restic repo identifier on the storage VPS for the orchestrator's
# own Mongo (projects, schedules, encrypted secrets, backup history). MUST
# never collide with a user project id. Default: `dockstash-self`.
SELF_BACKUP_REPO=dockstash-self
# Cron cadence for the self-backup job. Serialized through the per-repo BullMQ
# queue (see IDEA.md §6). Default: nightly at 03:00.
SELF_BACKUP_CRON=0 3 * * *

# ---------------------------------------------------------------------------
# Secrets — do NOT put values here. Populate the files under ./secrets/ and
# mount them as Docker secrets (see docker-compose.yml `secrets:` block):
#   ./secrets/master_encryption_key
#   ./secrets/polar_access_token
#   ./secrets/polar_webhook_secret
#   ./secrets/resend_api_key
# ---------------------------------------------------------------------------

# ===========================================================================
# Security & legal (prompt 11) — OPTIONAL with production-safe defaults.
# ===========================================================================
# Auth-route rate-limiter: window + max requests per IP inside the window.
# Defaults: 10 requests / 15 minutes.
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
# Webhook rate-limiter: applied BEFORE HMAC verification so a flood cannot
# waste CPU on signature math. Defaults: 120 / minute (~2 rps sustained).
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_WEBHOOK_MAX=120
# Fleet-agent machine surface (/api/agent) rate-limiter + liveness/lease windows.
# Sized for one agent per IP (heartbeat ~30s + poll ~10s + log batches).
RATE_LIMIT_AGENT_WINDOW_MS=60000
RATE_LIMIT_AGENT_MAX=600
# Agent counts as offline when its last heartbeat is older than this (3× beat).
AGENT_OFFLINE_AFTER_SECONDS=90
# A leased agent job fails if not renewed (log posts renew) within this window.
AGENT_JOB_LEASE_SECONDS=900
# CSRF double-submit cookie + header names. Both default to `x-csrf-token`.
CSRF_COOKIE_NAME=x-csrf-token
CSRF_HEADER_NAME=x-csrf-token
# Account-deletion grace period (hours). Repo purge is queued this many hours
# after the delete request; the final Resend warning fires 24h before purge.
# Default: 30 days.
ACCOUNT_DELETION_GRACE_HOURS=720
# Storage-VPS SSH host-key pin (sha256:BASE64). Leave blank in dev; production
# MUST set this — the SshTransport rejects on mismatch, no auto-accept.
STORAGE_SSH_HOST_KEY_FINGERPRINT=

# Legacy MERN integrations (optional — leave blank if unused)
STRIPE_SECRET_KEY=
SENDGRID_API_KEY=
MAILCHIMP_API_KEY=

# Restic execution. `process` spawns the real pinned restic binary (compose
# default); `placeholder` keeps the loud not-wired runner (tests, bare dev).
RESTIC_RUNNER=placeholder
RESTIC_BINARY=restic
RESTIC_CACHE_DIR=/tmp/restic-cache
# Docker Engine endpoint for database dump execs. Compose points this at the
# least-privilege socket proxy; leave blank to disable container execs.
DOCKER_HOST=

# Contact-form recipient email. Blank = fall back to a placeholder + warning.
CONTACT_RECIPIENT=
