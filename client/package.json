    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-i18next": "^15.7.4",
    "react-redux": "^9.3.0",
    "react-router-dom": "^6.30.4",
    "sirv": "^3.0.2",
    "socket.io-client": "^4.8.3",
