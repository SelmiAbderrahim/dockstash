    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.1.2",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.28.1",
    "sirv": "^3.0.0",
    "socket.io-client": "^4.8.3",
