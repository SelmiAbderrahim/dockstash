    "@fontsource/noto-naskh-arabic": "^5.2.11",
    "@hookform/resolvers": "^3.9.1",
    "@reduxjs/toolkit": "^2.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.7.5",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "i18next": "^23.16.5",
    "i18next-browser-languagedetector": "^8.0.0",
    "lucide-react": "^1.28.0",
    "moment": "^2.30.1",
