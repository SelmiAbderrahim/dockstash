    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@reduxjs/toolkit": "^2.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "express": "^4.22.2",
    "helmet": "^8.3.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.28.0",
    "moment": "^2.30.1",
