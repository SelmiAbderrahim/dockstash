{
  "name": "dockstash-client",
  "version": "2.0.0",
  "description": "Dockstash web client — React 18 + Vite + Tailwind v4 + shadcn/ui.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SelmiAbderrahim/dockstash.com.git",
    "directory": "client"
  },
  "homepage": "https://github.com/SelmiAbderrahim/dockstash.com#readme",
  "bugs": {
    "url": "https://github.com/SelmiAbderrahim/dockstash.com/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "NODE_ENV=production node server.js",
    "preview": "vite preview",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
