# Logs
logs
*.log
npm-debug.log*

# Runtime data
pids
*.pid
*.seed

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directories used by tools like istanbul / istanbul / c8 / vitest
coverage
**/coverage
cov-*
coverage-*
**/cov-*
**/coverage-*
.nyc_output
*.lcov

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directory
node_modules
client/node_modules
server/node_modules

# Vite build output / cache
client/dist
client/.vite
client/.vite-cache

# Server build output
server/dist

# Env files (root .env is the single source of truth — never commit it)
.env
.env.local

# Docker secret files (mounted via compose `secrets:` block — never commit)
/secrets/

# TypeScript incremental build info
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# IDE
.idea/

# Claude Code local settings (per-machine overrides)
.claude/settings.local.json

# OpenCode local secrets (API keys, per-machine overrides)
.opencode/local.json
.opencode/local.jsonc
.opencode/node_modules/