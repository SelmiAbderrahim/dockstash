  "description": "Dockstash API server — Express 4 + Mongoose 8 + Socket.IO.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SelmiAbderrahim/dockstash.com.git",
